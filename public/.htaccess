# Hostinger (LiteSpeed / Apache)
ErrorDocument 404 /404.html

# Cache : long et « immutable » seulement pour les fichiers versionnés générés par Astro (/_astro/, nom haché) ;
# une semaine pour les autres fichiers statiques non versionnés (favicon, polices, images, tarteaucitron),
# qui peuvent être remplacés sous le même nom (ex. logo du client).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Le dossier d'administration TinaCMS ne doit pas être indexé
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/admin/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>
