---
// Pictogrammes de la maquette (traits 24×24), toujours décoratifs.
interface Props {
  nom: 'coche' | 'telephone' | 'fleche' | 'lieu' | 'mail';
  taille?: number;
  couleur?: string;
  epaisseur?: number;
}
const { nom, taille = 18, couleur = 'currentColor', epaisseur = nom === 'coche' ? 2.5 : 2 } = Astro.props;
---

<svg width={taille} height={taille} viewBox="0 0 24 24" fill="none" stroke={couleur} stroke-width={epaisseur} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nom === 'coche' && <path d="M20 6 9 17l-5-5" />}
  {nom === 'fleche' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nom === 'telephone' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />}
  {nom === 'lieu' && <Fragment><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></Fragment>}
  {nom === 'mail' && <Fragment><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></Fragment>}
</svg>
