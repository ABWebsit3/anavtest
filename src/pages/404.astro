---
import Layout from '../layouts/Layout.astro';
import { langueDefaut } from '../moyo/site';
import { t } from '../i18n/ui';
const tx = t(langueDefaut);
---

<Layout titre={tx.pageIntrouvable} description={tx.pageIntrouvable} noindex>
  <h1>{tx.pageIntrouvable}</h1>
  <p><a class="btn" href="/">{tx.retourAccueil}</a></p>
</Layout>
