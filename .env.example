# Copier en .env pour le développement local (jamais commité).
# Option Analytics : identifiant GA4 (G-XXXXXXX), chargé uniquement après consentement.
PUBLIC_GA4_ID=
# Option e-commerce : clé publique Snipcart (clé de TEST en local, clé « live » uniquement en secret GitHub).
PUBLIC_SNIPCART_API_KEY=
# Espace d'édition TinaCMS en ligne (TinaCloud) — inutile pour `npm run dev:cms` en local.
TINA_CLIENT_ID=
TINA_TOKEN=
